# Neon Postgres (use the pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# better-auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# UploadThing (https://uploadthing.com/dashboard -> API Keys)
UPLOADTHING_TOKEN=""
# Public site origin (used for sitemap, robots, canonical URLs)
SITE_URL="http://localhost:3000"
